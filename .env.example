# GEMINI_API_KEY: Required for Gemini AI API calls.
# Do NOT commit real values. Set these in your hosting platform (Vercel) Environment Variables.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# VITE_GOOGLE_MAPS_API_KEY: Required for interactive Google Maps explorer.
# Get your own key from Google Cloud Console and restrict it to your domain.
VITE_GOOGLE_MAPS_API_KEY=""

# Supabase Real Database Configuration
# Create your own Supabase project and copy values from Project Settings → API.
# Never commit real keys to version control.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Platform Admin Credentials
# Set these only in your hosting platform Environment Variables. Never commit real values.
VITE_PLATFORM_ADMIN_EMAIL=""
VITE_PLATFORM_ADMIN_ALT_EMAIL=""
VITE_PLATFORM_ADMIN_PASSWORD=""
